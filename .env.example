# =============================================================================
# 数据 ETL 环境变量模板
# 用法：复制本文件为项目根目录的 .env，填入真实密码；.env 已在 .gitignore 中忽略。
#       cp .env.example .env
# ETL 脚本（Python）与 docker-compose（中间件）共用这一份 .env。
# =============================================================================

# ----- MySQL（元数据库 gy_meta）-----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_DATABASE=gy_meta
# docker-compose 中作为 root 密码使用，请改成强密码
MYSQL_PASSWORD=change_me

# ----- ClickHouse（数仓 gy_dw）-----
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_DATABASE=gy_dw
CLICKHOUSE_PASSWORD=change_me

# ----- MinIO（研报正文对象存储）-----
# 注意：ClickHouse native 已占用宿主机 9000，MinIO API 映射到 9002、控制台 9003
MINIO_ENDPOINT=127.0.0.1:9002
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me
MINIO_BUCKET=research-reports
