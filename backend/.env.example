# 复制为 backend/.env，并仅从本地安全渠道填写真实连接信息。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=gy_meta

# 未接入认证中间件时使用的明确系统标识；接入后以登录上下文为准。
DEFAULT_OPERATOR=system
ETL_SYSTEM_OPERATOR=etl-system

# 允许跨域访问的前端地址，逗号分隔。
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 火山方舟（Ark）大模型：用于新闻/摘要语义分类，留空则不启用。
# ARK_MODEL 填方舟控制台的模型 ID 或推理接入点 ID（形如 ep-2024xxxx）。
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=
ARK_TIMEOUT=30
